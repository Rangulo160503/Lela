{
  "name": "panaderia-lela",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host",
    "dev:api": "tsx watch server/src/index.ts",
    "build": "tsc -b && vite build",
    "build:web": "vite build",
    "start": "tsx server/src/index.ts",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview --host",
    "pack:portable": "powershell -ExecutionPolicy Bypass -File scripts/pack-portable.ps1"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "jspdf": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tsx": "^4.23.15",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
